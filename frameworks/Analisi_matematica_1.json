  "syllabus_modules": [
    {
      "id": 1,
      "name": "Insiemi numerici e funzioni",
      "core_contents": [
        "Numeri reali, complessi, insiemi",
        "Funzioni iniettive/suriettive, funzioni composte",
        "Funzioni elementari (polinomiali, razionali, trig, esponenziali)",
        "Disuguaglianze e valori assoluti"
      ],
      "learning_outcomes": [
        "Comprendere insiemi numerici",
        "Analizzare funzioni reali",
        "Manipolare disuguaglianze"
      ]
    },
    {
      "id": 2,
      "name": "Successioni",
      "core_contents": [
        "Definizione, operazioni, monotonia",
        "Limiti successioni, teorema Cesaro",
        "Successioni ricorsive",
        "Serie numeriche convergenza"
      ],
      "learning_outcomes": [
        "Studiare convergenza successioni",
        "Applicare teorema Cesaro",
        "Analizzare serie numeriche"
      ]
    },
    {
      "id": 3,
      "name": "Limiti e continuità",
      "core_contents": [
        "Definizione limite, teorema dei due poliziotti",
        "Continuità funzioni, teoremi Bolzano-Weierstrass",
        "Operazioni limiti, indeterminate",
        "Limiti laterali, funzioni continue per tratti"
      ],
      "learning_outcomes": [
        "Calcolare limiti complessi",
        "Verificare continuità",
        "Applicare teoremi fondamentali"
      ]
    },
    {
      "id": 4,
      "name": "Derivate",
      "core_contents": [
        "Definizione derivata, interpretazione geometrica",
        "Derivate funzioni elementari",
        "Regole derivazione (prodotto, quoziente, catena)",
        "Derivate superiori, accelerazione"
      ],
      "learning_outcomes": [
        "Calcolare derivate complesse",
        "Applicare regole derivazione",
        "Interpretare derivate fisicamente"
      ]
    },
    {
      "id": 5,
      "name": "Applicazioni derivate",
      "core_contents": [
        "Teorema Rolle, Lagrange, valori medi",
        "Massimi/minimi, convessità, flessioni",
        "Teorema L'Hôpital",
        "Studio asintoti obliqui"
      ],
      "learning_outcomes": [
        "Ottimizzare funzioni",
        "Studiare comportamento asintotico",
        "Applicare teoremi valori medi"
      ]
    },
    {
      "id": 6,
      "name": "Integrali indefiniti",
      "core_contents": [
        "Antiderivate, tavole integrative",
        "Integrazione per parti",
        "Sostituzioni, frazioni parziali",
        "Integrazioni ridotte"
      ],
      "learning_outcomes": [
        "Integrare funzioni razionali",
        "Applicare integrazione per parti",
        "Risoluzione integrali complessi"
      ]
    },
    {
      "id": 7,
      "name": "Integrali definiti",
      "core_contents": [
        "Definizione Riemann, proprietà integrali",
        "Teorema fondamentale calcolo",
        "Metodo trapezi, Simpson",
        "Applicazioni geometriche/aree/volumi"
      ],
      "learning_outcomes": [
        "Calcolare integrali definiti",
        "Applicare teorema fondamentale",
        "Stime numeriche integrali"
      ]
    },
    {
      "id": 8,
      "name": "Equazioni differenziali",
      "core_contents": [
        "ED separabili, lineari 1° ordine",
        "ED omogenee, esatte",
        "Equazioni lineari 2° ordine costanti",
        "Problemi valore iniziale"
      ],
      "learning_outcomes": [
        "Risolvere ED 1° ordine",
        "Analizzare ED 2° ordine",
        "Problemi valore iniziale"
      ]
    },
