  "alignment_method": {
    "description": "Allineamento = media ponderata dei criteri: score_i = max(0, 1 - |required_level_i - offered_score_i| / 4)",
    "formula": "alignment = Σ(weight_i × score_i) / Σ(weight_i)",
    "interpretation": {
      "85-100": "Eccellente - Rigoroso e applicativo - Adozione consigliata",
      "70-84": "Buono - Solido con qualche lacuna - Raccomandato+integrazioni",
      "55-69": "Sufficiente - Lacune su dimostrazioni/applicazioni - Con riserva",
      "<55": "Sconsigliato - Inadeguato per indirizzo - Non adottare"
    }
  },
