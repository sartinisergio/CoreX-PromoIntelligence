    "5": "livello massimo/avanzato"
  },
  "syllabus_modules": [
    {
      "id": 1,
      "name": "Codice genetico: DNA e RNA",
      "core_contents": ["Struttura DNA/RNA", "Basi azotate appaiamento", "Topologia DNA superavvolgimento", "Ribozimi", "RNA non-coding miRNA siRNA lncRNA"],
      "learning_outcomes": ["Descrivere struttura/topologia DNA/RNA", "Spiegare ruolo RNA non-coding", "Interpretare qualità sequenziamento"]
    },
    {
      "id": 2,
      "name": "Genomi ed elementi mobili",
      "core_contents": ["Organizzazione procarioti/eucarioti", "Introni/esoni", "Trasposoni retrotrasposoni", "DNA mitocondriale/plastidiale", "CNV inversioni pangenomi"],
      "learning_outcomes": ["Confrontare genomi procarioti/eucarioti", "Analizzare duplicazioni adattative", "Identificare elementi mobili"]
    },
    {
      "id": 3,
      "name": "Replicazione riparazione ricombinazione",
      "core_contents": ["Complesso replicazione primasi polimerasi", "Telomerasi forche", "Riparazione BER NER MMR", "Danno UV/ossidativo", "Ricombinazione omologa/non"],
      "learning_outcomes": ["Interpretare sensibilità UV mutanti", "Spiegare accorciamento telomeri", "Descrivere vie riparazione"]
    },
    {
      "id": 4,
      "name": "Trascrizione e regolazione genica",
      "core_contents": ["RNA polimerasi promotori enhancer", "Operoni procarioti", "Cromatina eucariotica", "Splicing editing stabilità RNA"],
      "learning_outcomes": ["Analizzare operone lac", "Interpretare heatmap espressione", "Valutare controllo post-trascrizionale"]
    },
    {
      "id": 5,
      "name": "Traduzione e qualità proteico",
      "core_contents": ["Ribosomi tRNA codici inizio/stop", "Cornice lettura", "Folding chaperoni", "Proteasoma autofagia"],
      "learning_outcomes": ["Prevedere effetti mutazione nonsenso", "Tracciare DNA a proteina", "Descrivere degradazione"]
    },
    {
      "id": 6,
      "name": "Cromatina ed epigenetica",
      "core_contents": ["Nucleosomi modificazioni istoniche", "Rimodellamento", "Metilazione DNA imprinting", "Eredità epigenetica"],
      "learning_outcomes": ["Interpretare ChIP-seq qualitativo", "Spiegare effetti ambientali epigenetici", "Analizzare nucleosomi"]
    },
    {
      "id": 7,
      "name": "Tecnologie biologia molecolare",
      "core_contents": ["PCR varianti elettroforesi", "Clonaggio vettori", "Sequenziamento NGS", "CRISPR editing"],
      "learning_outcomes": ["Progettare primer concettuale", "Navigare FASTA/FASTQ", "Descrivere principi CRISPR"]
