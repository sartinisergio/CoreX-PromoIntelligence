    "interpretation": {
      "85-100": "Eccellente - Copertura esaustiva+applicativa - Adozione consigliata",
      "70-84": "Buono - Solido con integrazioni - Raccomandato+integrazioni",
      "55-69": "Sufficiente - Lacune significative - Con riserva",
      "<55": "Sconsigliato - Incompleto/superficiale - Non adottare"
    }
