{
  "framework": {
    "name": "Framework Unico Valutazione Microbiologia",
    "version": "1.0",
    "description": "Framework integrato per valutare allineamento tra programmi di Microbiologia universitaria e manuali di testo, per contesti L-13, L-2, LM-41, LM-13, L-26, L-32, Professioni Sanitarie, LM-42.",
    "date": "2026-01-11"
  },
  "scale": {
    "1": "livello minimo/assente",
    "2": "livello molto basso/sporadico",
    "3": "livello moderato/base",
    "4": "livello alto/articolato",
    "5": "livello massimo/avanzato"
  },
  "syllabus_modules": [
    {
      "id": 1,
      "name": "Introduzione e biodiversità microbica",
      "core_contents": [
        "Batteri, archea, funghi, protozoi, alghe, virus, viroidi e prioni",
        "Ruoli in natura e nella società",
        "Esempi applicativi (es. lattobacilli nello yogurt)"
      ],
      "learning_outcomes": [
        "Classificare i microrganismi principali",
        "Identificare ruoli ecologici ed economici",
        "Distinguere virus DNA/RNA"
      ]
    },
    {
      "id": 2,
      "name": "Struttura e funzione della cellula microbica",
      "core_contents": [
        "Parete cellulare Gram+/−, membrana, spore, flagelli",
        "Biofilm e resistenze associate",
        "Esempi clinici (es. Pseudomonas su cateteri)"
      ],
      "learning_outcomes": [
        "Descrivere strutture chiave",
        "Spiegare formazione biofilm",
        "Correlare struttura a virulenza"
      ]
    },
    {
      "id": 3,
      "name": "Crescita, metabolismo e controllo",
      "core_contents": [
        "Curve di crescita, requisiti nutrizionali",
        "Fattori fisici/chimici per controllo",
        "Sterilizzazione vs disinfezione (autoclave vs filtrazione)"
      ],
      "learning_outcomes": [
        "Interpretare curve di crescita",
        "Selezionare metodi di controllo",
        "Applicare norme di sicurezza"
      ]
    },
    {
      "id": 4,
      "name": "Genetica e genomica microbica",
      "core_contents": [
        "Mutazioni, trasferimento orizzontale (conjugazione, trasformazione, trasduzione)",
        "NGS, metagenomica, resistoma",
        "Plasmidi e diffusione resistenze"
      ],
      "learning_outcomes": [
        "Descrivere meccanismi genetici",
        "Interpretare resistomi",
        "Analizzare trasferimenti genici"
      ]
    },
    {
      "id": 5,
      "name": "Virologia di base",
      "core_contents": [
        "Struttura, replicazione, cicli litico/lisogeno",
        "Coltura virale, antivirali",
        "Es. inibitori neuraminidasi vs coronavirus"
      ],
      "learning_outcomes": [
        "Classificare virus",
        "Spiegare cicli replicativi",
        "Valutare antivirali"
      ]
    },
    {
      "id": 6,
      "name": "Micologia e parassitologia essenziali",
      "core_contents": [
        "Lieviti/muffe rilevanti, protozoi, elminti",
        "Diagnosi differenziale (Candida vs batteri)"
      ],
      "learning_outcomes": [
        "Identificare patogeni",
        "Interpretare colture emocolture",
        "Applicare diagnostica"
      ]
    },
    {
      "id": 7,
      "name": "Immunologia applicata alla microbiologia",
      "core_contents": [
        "Immunità innata/adattativa, vaccini",
        "Test sierologici IgM/IgG",
        "Immunopatologia"
      ],
      "learning_outcomes": [
        "Interpretare profili immunitari",
        "Valutare vaccini",
        "Analizzare test sierologici"
      ]
    },
    {
      "id": 8,
      "name": "Patogenesi, epidemiologia e prevenzione",
      "core_contents": [
        "Fattori virulenza, trasmissione, sorveglianza",
        "Outbreak, stewardship antibiotica",
        "Es. focolaio Salmonella"
      ],
      "learning_outcomes": [
        "Analizzare patogenesi",
        "Tracciare epidemie",
        "Applicare stewardship"
      ]
    },
    {
      "id": 9,
      "name": "Microbiologia ambientale e cicli biogeochimici",
      "core_contents": [
        "Cicli C/N/S, biodegradazione, microbiologia acque",
        "Fanghi attivi depuratori"
      ],
      "learning_outcomes": [
        "Descrivere cicli biogeochimici",
        "Valutare biorisanamento",
        "Monitorare qualità acque"
      ]
    },
    {
      "id": 10,
      "name": "Microbiologia industriale e alimentare",
      "core_contents": [
        "Fermentazioni, starter, HACCP",
        "Es. Grana Padano vs Gorgonzola"
      ],
      "learning_outcomes": [
        "Progettare fermentazioni",
        "Applicare HACCP",
        "Selezionare starter"
      ]
    },
    {
      "id": 11,
      "name": "Metodi di laboratorio e qualità",
      "core_contents": [
        "Colture, colorazioni, antibiogramma EUCAST, PCR, MALDI-TOF",
        "BSL-1/2/3, GLP, gestione rifiuti"
      ],
      "learning_outcomes": [
        "Eseguire protocolli diagnostici",
        "Interpretare risultati",
        "Applicare norme qualità"
      ]
    },
    {
      "id": 12,
      "name": "Bioinformatica di base per microbiologia",
      "core_contents": [
        "Database NCBI/ENA, filogenesi, epidemiologia genomica",
        "Confronto genomi per clonalità"
      ],
      "learning_outcomes": [
        "Usare database",
        "Costruire alberi filogenetici",
        "Analizzare cluster genomici"
      ]
    }
  ],
