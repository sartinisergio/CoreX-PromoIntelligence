      "learning_outcomes": [
        "Grafici cinetici",
        "Calcolo Ea",
        "Meccanismi proposti"
      ]
    },
    {
      "id": 7,
      "name": "Equilibri chimici",
      "core_contents": [
        "Costante Kc/Kp, principio Le Chatelier",
        "Calcoli equilibri gassosi/eterogenei",
