        "Celle elettrolitiche, leggi Faraday",
        "Corrosione, batterie (Pb, NiCd, Li-ion)",
        "Elettrodi riferimento"
      ],
      "learning_outcomes": [
        "Calcoli E°/E",
        "Quantità elettrolisi",
        "Batterie funzionamento"
      ]
    },
    {
      "id": 10,
