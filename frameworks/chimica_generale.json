      "learning_outcomes": [
        "Calcoli ΔH/ΔS/ΔG",
        "Predire spontaneità",
        "Bilanci energetici"
      ]
    },
    {
      "id": 5,
      "name": "Stati materia e soluzioni",
      "core_contents": [
        "Leggi gas ideali, miscele, pressioni parziali",
        "Teoria cinetica gas, gas reali",
        "Cambi stato, diagrammi fase",
        "Soluzioni: molalità, molarità, % massa",
        "Proprietà colligative (ebullio, crioscopia, osmosi)"
      ],
      "learning_outcomes": [
        "Calcoli PV=nRT",
        "Pressioni parziali",
        "Osmotic pressure"
      ]
    },
    {
      "id": 6,
      "name": "Cinetica chimica",
      "core_contents": [
        "Velocità reazione, ordine, cinetica integrata",
        "Equazione Arrhenius, energia attivazione",
        "Meccanismi elementari, stato attivato",
        "Catalisi omogenea/eterogenea",
        "Cinetica enzimatica (Michaelis-Menten)"
