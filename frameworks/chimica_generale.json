  "syllabus_modules": [
    {
      "id": 1,
      "name": "Struttura atomica e tavola periodica",
      "core_contents": [
        "Particelle subatomiche, isotopi, numero Avogadro",
        "Modello Bohr, spettri atomici",
        "Numeri quantici, orbitali s/p/d/f",
        "Configurazioni elettroniche, eccezioni",
        "Raggio atomico, IE, elettronegatività"
      ],
      "learning_outcomes": [
        "Predire configurazioni elettroniche",
        "Tendenze periodicità",
        "Spiegare proprietà elementi"
      ]
    },
    {
      "id": 2,
      "name": "Legame chimico e geometria molecolare",
      "core_contents": [
        "Teoria Lewis, regola ottetto/18 elettroni",
        "VSEPR (lineare, planare, tetraedrica)",
        "Ibridazione sp/sp2/sp3",
        "Polarità legami/molecole, momento dipolare",
        "Legami metallici, energia reticolare"
      ],
      "learning_outcomes": [
        "Predire geometria/polarità",
        "Disegnare strutture Lewis",
        "Spiegare risonanza"
      ]
    },
    {
      "id": 3,
      "name": "Stechiometria e reazioni chimiche",
      "core_contents": [
        "Mole, massa molare, composizione %",
        "Bilanciamento equazioni, yield teorico/esperim.",
        "Reazioni: precipitazione, acido-base, redox",
        "Stechiometria soluzioni, diluizioni",
        "Numeri ossidazione, bilanciamento redox"
      ],
      "learning_outcomes": [
        "Calcoli massa/moli",
        "Bilanciamento redox",
        "Yield reazioni"
      ]
    },
    {
      "id": 4,
      "name": "Termodinamica e termochimica",
      "core_contents": [
        "Energia interna, entalpia, 1° principio",
        "Calorimetria, capacità termica",
        "Legge Hess, entalpie formazione",
        "Entropia, 2° principio, energia libera Gibbs",
        "Cicli Born-Haber, spontaneità"
