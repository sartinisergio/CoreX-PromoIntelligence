        "Equilibri multipli, approssimazioni",
        "Q vs K"
      ],
      "learning_outcomes": [
        "Calcoli concentrazioni equilibrio",
        "Predire spostamenti",
        "Equilibri complessi"
      ]
    },
    {
      "id": 8,
      "name": "Equilibri acido-base",
      "core_contents": [
        "Arrhenius, Brønsted-Lowry, Lewis",
