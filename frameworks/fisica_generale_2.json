  "syllabus_modules": [
    {
      "id": 1,
      "name": "Campi elettrostatici",
      "core_contents": [
        "Legge Coulomb, campo E punto carica",
        "Teorema Gauss, potenziale elettrostatico",
        "Dipolo elettrico, multipoli"
      ],
      "learning_outcomes": [
        "Calcolo campi continui",
        "Equipotenziali, linee campo"
      ]
    },
    {
      "id": 2,
      "name": "Materiali dielettrici",
      "core_contents": [
        "Polarizzazione P, spostamento D",
        "Dielettrici lineari, costante ε",
        "Condensatori dielettrici"
      ],
      "learning_outcomes": [
        "Effetti dielettrici",
        "Capacità aumentata"
      ]
    },
    {
      "id": 3,
      "name": "Corrente elettrica e circuiti",
      "core_contents": [
        "Legge Ohm, Kirchhoff tensioni/correnti",
        "Circuiti RC/RL, costante tempo",
        "Potenza Joule"
      ],
      "learning_outcomes": [
        "Analisi circuiti transitori",
        "Bilanci potenza"
      ]
    },
    {
      "id": 4,
      "name": "Magnetostatica",
      "core_contents": [
        "Forza Lorentz, Biot-Savart, Ampère",
        "Campo B solenoidi, dipolo magnetico"
      ],
      "learning_outcomes": [
        "Calcolo campi magnetici",
        "Linee campo B"
      ]
    },
    {
      "id": 5,
      "name": "Materiali magnetici",
      "core_contents": [
        "Diam/para/ferromagnetismo",
        "Campo H, cicli isteresi",
        "Induttori nucleo magnetico"
      ],
      "learning_outcomes": [
        "Proprietà magnetiche materiali",
        "Perdite magnetiche"
      ]
    },
    {
      "id": 6,
      "name": "Induzione elettromagnetica",
      "core_contents": [
        "Faraday, Lenz, flusso magnetico",
        "Induttanza auto/mutua",
        "Circuiti RLC serie/parallelo"
      ],
      "learning_outcomes": [
        "fem indotte, oscillatori RLC"
      ]
    },
    {
      "id": 7,
      "name": "Equazioni di Maxwell",
      "core_contents": [
        "4 equazioni integrali/differenziali",
        "Equazione onda EM, vettore Poynting"
      ],
      "learning_outcomes": [
        "Formalismo completo EM",
        "Trasporto energia EM"
      ]
    },
    {
      "id": 8,
      "name": "Onde elettromagnetiche",
      "core_contents": [
        "Onde piane, polarizzazione",
        "Impedenza onda, Poynting medio",
        "Riflessione/rifrazione"
      ],
      "learning_outcomes": [
        "Velocità onda EM",
        "Spettro EM"
      ]
    },
    {
      "id": 9,
      "name": "Ottica geometrica",
      "core_contents": [
        "Rifrazione, lenti, strumenti ottici",
        "Interferenza, diffrazione",
        "Reticolari, spettroscopia"
      ],
      "learning_outcomes": [
        "Strumenti ottici",
        "Risoluzione strumenti"
      ]
    },
    {
      "id": 10,
      "name": "Relatività ristretta",
      "core_contents": [
        "Postulati, contrazione/dilatazione",
